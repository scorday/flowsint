FROM node:22.21.1-bookworm-slim AS sdk
WORKDIR /sdk/core-sdk
COPY --from=ui packages/core-sdk/package.json packages/core-sdk/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY --from=ui packages/core-sdk/src ./src
COPY --from=ui packages/core-sdk/tsconfig.json packages/core-sdk/tsconfig.build.json packages/core-sdk/README.md ./
RUN npm run build && mkdir -p /packs && npm pack --pack-destination /packs && mv /packs/avl4-core-sdk-*.tgz /packs/core-sdk.tgz
WORKDIR /sdk/core-sdk-react
COPY --from=ui packages/core-sdk-react/package.json packages/core-sdk-react/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY --from=ui packages/core-sdk-react/src ./src
COPY --from=ui packages/core-sdk-react/tsconfig.json packages/core-sdk-react/tsconfig.build.json packages/core-sdk-react/README.md ./
RUN npm run build && npm pack --pack-destination /packs && mv /packs/avl4-core-sdk-react-*.tgz /packs/core-sdk-react.tgz

FROM node:22.21.1-bookworm-slim AS builder
WORKDIR /app
COPY --from=sdk /packs /packs
COPY flowsint-app/package.json flowsint-app/yarn.lock ./
# Local stack builds SDK packs from the same checkout as main_panel. Other
# application dependencies retain their Yarn lock. No private npm token is needed.
RUN node -e 'const fs=require("fs");const p=JSON.parse(fs.readFileSync("package.json"));delete p.dependencies["@avl4/core-sdk"];delete p.dependencies["@avl4/core-sdk-react"];fs.writeFileSync("package.json",JSON.stringify(p));' \
    && yarn install --frozen-lockfile --ignore-scripts --network-timeout 120000 \
    && yarn add --offline --ignore-scripts --no-lockfile /packs/core-sdk.tgz /packs/core-sdk-react.tgz
COPY flowsint-app/ ./
ENV VITE_AUTH_MODE=avl4 VITE_RUNTIME_CONFIG=true
RUN yarn build

FROM nginx:1.29.2-alpine AS runtime
RUN rm /etc/nginx/conf.d/default.conf
COPY flowsint-app/nginx.avl4.conf /etc/nginx/nginx.conf
COPY --from=builder /app/dist /usr/share/nginx/html
USER nginx
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=12 CMD wget -q --spider http://127.0.0.1:8080/health || exit 1
CMD ["nginx", "-g", "daemon off;"]

# Staging uses the same compiled application with the canonical public runtime loader.
FROM runtime AS staging
USER root
RUN apk add --no-cache jq
COPY --from=deployment docker/40-runtime-config.sh /docker-entrypoint.d/40-runtime-config.sh
COPY --from=deployment docker/runtime-config.jq /etc/avl4-ui/runtime-config.jq
RUN chmod 755 /docker-entrypoint.d/40-runtime-config.sh \
    && mkdir -p /tmp/avl4-ui && chown nginx:nginx /tmp/avl4-ui
# The base config already provides /health and serves the SPA; use its runtime alias.
RUN sed -i 's|try_files \$uri =404;|alias /tmp/avl4-ui/runtime-config.json;|' /etc/nginx/nginx.conf
USER nginx
